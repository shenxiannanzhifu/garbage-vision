        "part_similarity_gap": 0.015,
        "max_objects": 40,
        "crop_padding": 0.05,
        "diagnostic_regions": true,
        "clip_resize_mode": "letterbox",
        "text_templates": [
          "a photo of {}.",
          "a close-up photo of {}.",
          "a photo of one or more {}."
        ],
        "visual_support": "weights/visual-support-b32.npz",
        "visual_similarity_min": 0.65,
        "visual_margin_min": 0.04
      },
      "score_note": "mask_quality 为 SAM 预测掩膜质量；similarity 为 CLIP 余弦相似度。均非垃圾类别概率。"
    }
  }
}