# 实际文件为.env.stage3，始终忽略且不进Git。运行本机入口会生成访问令牌，不打印它。
GV_S3_ACCESS_TOKEN=
GV_S3_API_URL=http://127.0.0.1:8000
GV_S3_DEVICE=auto
# 默认禁止收费；只有取得新的明确次数/预算/图片范围授权后才能配置。
GV_S3_PAID_CALL_LIMIT=0
GV_S3_AUTHORIZATION_ID=
# limited使用上述次数上限；用户确认按需调用后可设manual，并使用新的授权编号。
# manual不限制总次数，但仍需逐项include_api、访问凭据和有效服务商配置。
GV_S3_PAID_MODE=limited
# Linux容器中使用/data，Windows默认.local/stage3-data
# GV_S3_DATA_DIR=/data
