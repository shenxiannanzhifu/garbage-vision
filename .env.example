# 仅在本地填写；实际 .env 已被 Git 忽略。不要在聊天中发送密钥。
GV_API_PROVIDER=openai
# 首选 OpenAI；与下方百炼密钥分别保存。不要填写 Codex 登录令牌。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_API_ENABLED=false
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=high
OPENAI_TIMEOUT=120
OPENAI_USE_ENV_PROXY=false

# 用户提供的第三方服务；使用时设 GV_API_PROVIDER=nexavlinks。
# 该密钥只发送到 https://www.nexavlinks.com/v1，与官方 API 凭据分开。
NEXAVLINKS_API_KEY=
NEXAVLINKS_MODEL=gpt-6-astra
NEXAVLINKS_API_ENABLED=false
NEXAVLINKS_MAX_OUTPUT_TOKENS=2048
NEXAVLINKS_TIMEOUT=120
NEXAVLINKS_PROXY_URL=
# png 为已验证默认；lossless 为需真实小样验证的无损上传候选。
NEXAVLINKS_IMAGE_TRANSPORT=png

# 以下为历史百炼方案。明确决定切回时，将 GV_API_PROVIDER 改为 dashscope。
GV_API_KEY=
# 可选：使用业务空间专属端点时填写；普通本地实验不必填写。
GV_API_WORKSPACE_ID=
# 已有其他兼容服务时可直接指定其已核实的 HTTPS Base URL。
GV_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GV_API_MODEL=qwen3-vl-plus
GV_API_TIMEOUT=60
GV_API_MAX_TOKENS=2048
GV_API_MAX_ATTEMPTS=1
# 北京接口默认直连；只有使用需要代理的服务时才开启继承环境代理。
GV_API_USE_ENV_PROXY=false
# 本地填好后改成 true；网页仍需要主动点击运行才会发送图片。
GV_API_ENABLED=false
